# MongoDB Configuration
MONGODB_URI=

# Cloudinary Configuration (for image uploads)
CDN_CLOUD_NAME=
CDN_API_KEY=
CDN_API_SECRET=

# JWT Configuration (for authentication)
JWT_SECRETS=

# Comma-separated list of email domains allowed to register (school-verified
# identity). Defaults to example.edu if unset -- set this to your real
# school domain(s) before deploying.
ALLOWED_EMAIL_DOMAINS=example.edu

# Secret checked against the Authorization header on the daily cron job
# that archives expired listings. Vercel automatically sends
# "Authorization: Bearer <CRON_SECRET>" on its own Cron triggers when this
# env var is set on the project -- no extra vercel.json config needed for
# the header itself.
CRON_SECRET=
